# Keep EAS archives deterministic and free of local secrets/build locks.
node_modules/
apps/*/node_modules/
.expo/
.expo-*/
.eas-archive-check/
apps/mobile/.expo/
apps/mobile/.expo-*/
apps/mobile/.eas-archive-check/
apps/mobile/.expo-shared/
apps/mobile/.metro-health-check*
android/.gradle/
android/build/
android/app/build/
android/.cxx/
apps/api/dist/
apps/web/.next/
apps/web/.next-dev/
coverage/
dist/
.env
.env.*
!.env.example
apps/*/.env
apps/*/.env.*
!apps/*/.env.example
*.log
*firebase-admin*.json
*service-account*.json
.vercel/
