generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @db.Uuid
  fullName      String         @map("full_name")
  role          String
  email         String?
  mobileNumber  String?        @map("phone_number")
  employeeId    String?        @unique(map: "profiles_employee_id_unique_idx")
  company       String?        @map("company_name")
  status        Boolean        @default(true) @map("is_active")
  createdById   String?        @map("created_by") @db.Uuid
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdBy     User?          @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdUsers  User[]         @relation("UserCreatedBy")
  managedVisits Visit[]        @relation("ManagedVisits")
  notifications Notification[]
  auditLogs     AuditLog[]

  @@map("profiles")
}

model Site {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind      String
  name      String   @map("value")
  address   String   @default("")
  imagePath String?  @map("image_path")
  sortOrder Int      @default(100) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([kind, name])
  @@map("master_data")
}

model Visit {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  visitorName       String    @map("visitor_name")
  company           String
  purpose           String
  category          String    @default("Guest")
  mobile            String?
  email             String?
  building          String
  floor             String
  room              String
  scheduledAt       DateTime  @map("scheduled_at") @db.Timestamptz(6)
  siteManagerId     String    @map("host_user_id") @db.Uuid
  siteManagerName   String    @map("host_name")
  status            String    @default("INVITED")
  qrToken           String    @unique @map("qr_token")
  photoRequired     Boolean   @default(true) @map("photo_required")
  livePhotoCaptured Boolean   @default(false) @map("live_photo_captured")
  consentCaptured   Boolean   @default(false) @map("consent_captured")
  idVerified        Boolean   @default(false) @map("id_verified")
  checkedInAt       DateTime? @map("checked_in_at") @db.Timestamptz(6)
  checkedOutAt      DateTime? @map("exited_at") @db.Timestamptz(6)
  notes             String?
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  siteManager       User      @relation("ManagedVisits", fields: [siteManagerId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([siteManagerId], map: "visits_host_user_id_idx")
  @@index([status], map: "visits_status_idx")
  @@index([qrToken], map: "visits_qr_token_idx")
  @@map("visits")
}

model Notification {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  title       String
  message     String
  targetRoles String[] @default(["admin", "host", "receptionist"]) @map("target_roles")
  isRead      Boolean  @default(false) @map("is_read")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId], map: "notifications_user_id_idx")
  @@map("notifications")
}

model AuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  actorName   String?  @map("actor_name")
  actorRole   String?  @map("actor_role")
  action      String
  targetTable String   @map("target_table")
  targetId    String?  @map("target_id") @db.Uuid
  detail      String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([actorUserId], map: "audit_logs_actor_user_id_idx")
  @@map("audit_logs")
}
